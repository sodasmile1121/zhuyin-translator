# Copy this file to .env next to docker-compose.yml and fill in the values.
# .env is ignored by git and must never be committed.

# S3 bucket the gateway uploads to and the worker reads from / writes to.
AWS_S3_BUCKET=

# Postgres password. Generate one with: openssl rand -hex 16
# Use only letters and digits, it is embedded in a connection URL.
POSTGRES_PASSWORD=

# Grafana admin login.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Origins allowed to call the API and open WebSockets (comma separated).
# Defaults to http://localhost:8081 when unset. Add the host's address to use it directly.
# ALLOWED_ORIGINS=http://localhost:8081,http://<host>:8081

# IMAGE_TAG is written by the CI deploy job; it defaults to "latest".

# Copy this file to .env next to docker-compose.yml and fill in the values.
# .env is ignored by git and must never be committed.

# S3 bucket the gateway uploads to and the worker reads from / writes to.
AWS_S3_BUCKET=

# Postgres password. Generate one with: openssl rand -hex 16
# Use only letters and digits, it is embedded in a connection URL.
POSTGRES_PASSWORD=

# Grafana admin login.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Origins allowed to call the API and open WebSockets (comma separated).
# Defaults to http://localhost:8081 when unset. Add the host's address to use it directly.
# ALLOWED_ORIGINS=http://localhost:8081,http://<host>:8081

# IMAGE_TAG is written by the CI deploy job; it defaults to "latest".

# Optional tuning. Everything below is commented out because the defaults shown are what runs when unset
# (the defaults live in the code, these lines only document them). Do not set a variable to an empty value:
# leave it out, or the worker fails to parse it.
# Uncomment and change a value only to tune behaviour (for example, shorter values make failure
# scenarios show up in minutes instead of tens of minutes when verifying on a test host).

# Reconciler (gateway): re-publishes jobs that stayed "pending" because the task never reached the queue.
# Durations use Go syntax: 30s, 5m, 1h. RECONCILE_INTERVAL=0 disables it.
# RECONCILE_INTERVAL=1m        # how often to scan
# RECONCILE_OLDER_THAN=5m      # a pending job older than this counts as stuck
# RECONCILE_COOLDOWN=10m       # do not re-publish the same job again within this time

# Worker: retry and crash recovery for tasks in the queue.
# WORKER_COUNT=3               # worker processes per container
# CLAIM_MIN_IDLE_MS=60000      # an unacknowledged task is taken over by another worker after this long
# READ_BLOCK_MS=10000          # how long a worker waits for a new task before looping
# MAX_DELIVERIES=3             # after this many deliveries a task is moved to the dead-letter queue

